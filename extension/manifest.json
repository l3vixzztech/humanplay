{
  "manifest_version": 3,
  "name": "humanplay",
  "version": "0.1.0",
  "description": "Human-like chess move assistant: captures the board from the tab and asks a local Maia-3 helper server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "humanplay — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/ui/sidepanel.html"
  },
  "permissions": ["activeTab", "storage", "sidePanel", "downloads"],
  "host_permissions": ["http://127.0.0.1:8765/*"]
}
