{
  "manifest_version": 3,
  "name": "humanplay",
  "version": "0.7.0",
  "description": "Human-like chess move assistant for chess.com: reads the game state from the DOM, asks a local Maia-3 helper server, draws the suggested move on the board, speaks it (just the move), plans one safe premove and explains every move it sees (optional LLM rephrasing).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "humanplay — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/ui/sidepanel.html"
  },
  "permissions": ["activeTab", "storage", "sidePanel", "downloads", "tts"],
  "optional_host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "toggle-tts": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Toggle TTS move announcements (speak the suggested move)"
    }
  },
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://chess.com/*"],
      "js": ["src/content/chesscom-adapter.js", "src/content/board-overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/board-dom.js",
        "src/content/move-history.js",
        "src/content/board-locate.js",
        "src/content/overlay-geometry.js",
        "vendor/chess.js"
      ],
      "matches": ["https://www.chess.com/*", "https://chess.com/*"]
    }
  ]
}
